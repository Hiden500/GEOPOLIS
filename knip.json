{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/**/*.{mjs,js,ts}"],
      "project": ["scripts/**/*.{mjs,js,ts}", "shared/src/**/*.ts"]
    },
    "client": {
      "project": ["**/*.{ts,tsx,js,jsx}"]
    },
    "server": {
      "entry": ["scripts/**/*.ts"],
      "project": ["**/*.ts"]
    }
  }
}

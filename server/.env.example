# Копия в server/.env (уже в .gitignore, реальный файл никогда не коммитить).
# Нужен только для автоматизированного LLM-цикла (POST /llm/auto) — ручной
# цикл (copy-paste промта/ответа) работает без .env вообще.

# Какой автопровайдер использовать: local (по умолчанию) или gemini.
# Опечатка здесь роняет запрос с явной ошибкой, а не откатывается молча на
# дефолт: тихий откат увёл бы ходы не к той модели незаметно для игрока.
# LLM_PROVIDER=local

# ── OpenAI-совместимый эндпоинт (LM Studio, llama.cpp, Ollama, шлюз с ключом) ──
# Числа ниже измерены на реальном промте хода —
# .agent/runs/local-llm-runtime-bench-2026-07-30.json.
#
# Что доступно по текущим настройкам, показывает (из server/):
#   npx tsx scripts/listLocalModels.ts

# Адрес OpenAI-совместимого API. Дефолт — порт LM Studio по умолчанию.
# LOCAL_LLM_BASE_URL=http://localhost:1234/v1

# Имя модели. LM Studio отдаёт загруженную на любое имя, поэтому обычно не
# требуется; шлюзу с несколькими моделями — обязательно, и опечатка в нём
# ловится listLocalModels.ts и preflight'ом кампании, а не первым ходом.
# LOCAL_LLM_MODEL=local-model

# Лимит генерации. НЕ опускать ниже 8192 при включённом размышлении: замер дал
# 3/10 схема-валидных на 4096 против 8/8 на 8192 — размышление съедало лимит
# целиком, и на JSON токенов не оставалось.
# LOCAL_LLM_MAX_TOKENS=8192

# Как просить у модели JSON. Дефолт "prompt": response_format не отправляется,
# а в конец промта дописывается инструкция «верни только JSON». Замер
# .agent/runs/gemini-prompt-modes-2026-08-01 (140 вызовов через шлюз с ключом):
# без инструкции ответ приходил в markdown-заборе 60 раз из 60 ОДИНАКОВО при
# strict-схеме, нестрогой схеме, json_object и вообще без response_format;
# с инструкцией — 0 из 80. Выдуманных идентификаторов отказ от схемы не добавил
# (2 прогона из 40 против 8 из 100, p = 0,72).
#   json_schema — прежнее поведение целиком: строгая схема, промт без добавки.
#                 Нужно рантайму, который грамматику ДЕЙСТВИТЕЛЬНО применяет
#                 (LM Studio, llama.cpp) — про него замер на шлюзе не говорит
#                 ничего.
#   json_object — свободный JSON-режим OpenAI плюс та же инструкция.
# Опечатка роняет запрос с явной ошибкой, а не откатывается молча на дефолт.
# LOCAL_LLM_RESPONSE_FORMAT=prompt

# Гашение размышления. Пусто (дефолт) — размышление включено: ход 60 с, ноль
# выдуманных идентификаторов. "none" — ход 6 с, но 7 выдуманных доменов
# технологий на 10 ходов, и движок отклонит эти действия.
# LOCAL_LLM_REASONING=none

# Таймаут одного хода, мс. Дефолт 300000 — запас на холодную загрузку модели и
# разросшийся к поздней партии промт.
# LOCAL_LLM_TIMEOUT_MS=300000

# Ключ для серверов, требующих авторизацию (vLLM, LiteLLM, облачные шлюзы).
# Локальному рантайму не нужен — LM Studio не аутентифицирует. Уходит как
# заголовок Authorization: Bearer <ключ> и из провайдера, и из обоих скриптов
# (прогон кампании, замер моделей).
# LOCAL_LLM_API_KEY=

# ── Облачный провайдер ──
# Обязателен при LLM_PROVIDER=gemini.
GEMINI_API_KEY=

# Опционально — модель, дефолт в коде: gemini-3.1-flash-lite
# (проверена живым тестом с responseSchema, см. docs/DECISIONS.md, 2026-07-05).
# GEMINI_MODEL=gemini-3.1-flash-lite

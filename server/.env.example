# Копия в server/.env (уже в .gitignore, реальный файл никогда не коммитить).
# Нужен только для автоматизированного LLM-цикла (POST /llm/auto) — ручной
# цикл (copy-paste промта/ответа) работает без .env вообще.

# Обязателен для автопровайдера Gemini.
GEMINI_API_KEY=

# Опционально — модель, дефолт в коде: gemini-3.1-flash-lite
# (проверена живым тестом с responseSchema, см. docs/DECISIONS.md, 2026-07-05).
# GEMINI_MODEL=gemini-3.1-flash-lite

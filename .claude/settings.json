{
  "env": {
    "ENABLE_TOOL_SEARCH": "auto:5"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/guard.mjs",
            "timeout": 10,
            "statusMessage": "guard: worktree/данные/git-safety"
          }
        ]
      }
    ]
  }
}

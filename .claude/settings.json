{
  "env": {
    "ENABLE_TOOL_SEARCH": "auto:5"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/guard.mjs",
            "timeout": 10,
            "statusMessage": "guard: worktree/данные/git-safety"
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/role-guard.mjs",
            "timeout": 10,
            "statusMessage": "роль: оркестратор не исполняет"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/skill-marker.mjs",
            "timeout": 10,
            "statusMessage": "skill-marker: отметка вызова"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/role-guard.mjs",
            "timeout": 10,
            "statusMessage": "роль: якорь и реестр"
          }
        ]
      }
    ]
  }
}

{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|apply_patch|shell|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/guard.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  }
}

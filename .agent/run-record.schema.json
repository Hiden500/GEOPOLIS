{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geopolis.local/schemas/agent-run-record.schema.json",
  "title": "Geopolis agent run record",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "run_id",
    "task_identifier",
    "agent",
    "starting_commit",
    "ending_commit",
    "branch",
    "sandbox_mode",
    "approval_mode",
    "network_mode",
    "tools_used",
    "commands",
    "tests_executed",
    "baseline_failures",
    "introduced_failures",
    "human_interventions",
    "files_changed",
    "agent_configuration_mutations",
    "elapsed_seconds",
    "token_usage",
    "cost",
    "final_status",
    "unresolved_risks"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "type": "integer", "minimum": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "task_identifier": { "type": "string", "minLength": 1 },
    "agent": {
      "type": "object",
      "required": ["client", "name", "model", "reasoning_setting"],
      "properties": {
        "client": { "type": ["string", "null"] },
        "name": { "type": ["string", "null"] },
        "model": { "type": ["string", "null"] },
        "reasoning_setting": { "type": ["string", "null"] }
      }
    },
    "started_at": { "type": ["string", "null"] },
    "finished_at": { "type": ["string", "null"] },
    "elapsed_seconds": { "type": ["number", "null"], "minimum": 0 },
    "starting_commit": { "type": "string", "minLength": 7 },
    "ending_commit": { "type": "string", "minLength": 7 },
    "branch": { "type": "string", "minLength": 1 },
    "sandbox_mode": { "type": ["string", "null"] },
    "approval_mode": { "type": ["string", "null"] },
    "network_mode": { "type": ["string", "null"] },
    "tools_used": { "type": "array", "items": { "type": "string" } },
    "commands": { "type": "array", "items": { "type": "object" } },
    "tests_executed": { "type": "array", "items": { "type": "string" } },
    "baseline_failures": { "type": "array", "items": { "type": "string" } },
    "introduced_failures": { "type": "array", "items": { "type": "string" } },
    "human_interventions": { "type": "integer", "minimum": 0 },
    "files_changed": { "type": "array", "items": { "type": "string" } },
    "agent_configuration_mutations": { "type": "array", "items": { "type": "string" } },
    "token_usage": { "type": ["number", "null"], "minimum": 0 },
    "cost": { "type": ["number", "null"], "minimum": 0 },
    "final_status": { "type": "string", "minLength": 1 },
    "unresolved_risks": { "type": "array", "items": { "type": "string" } }
  }
}
